# Single source of truth for all dn42 peers.
# Run `peerctl.py apply` after editing to regenerate WireGuard + BIRD2 config
# and reload both services.

my_asn: 4242421234          # your dn42 ASN
my_wg_pubkey_file: /etc/wireguard/privkey   # server's WG private key (generate once with `wg genkey`)
router_id: 172.22.1.1        # your dn42 loopback / router-id

# Your registered dn42 loopback addresses (from the dn42 registry, not a peer
# link address). peerctl.py bootstrap/apply creates a "dn42" dummy interface
# and assigns these, so BGP has a stable router-id independent of any single
# WireGuard tunnel being up.
loopback:
  ipv4: 172.22.1.1/32
  ipv6: fd00:1234:5678::1/128   # optional, omit if you don't have a dn42 IPv6 block

# Your registered dn42/ChaosVPN/etc network blocks (from your aut-num/route(6)
# registry objects), used for the is_self_net()/OWNNETSET checks and the
# "route ... reject;" static blocks that let BIRD originate them. Add one
# entry per registered prefix.
own_networks:
  ipv4:
    - 172.22.1.0/28
  ipv6:
    - fd00:1234:5678::/48

# Origin communities (64511, region) / (64511, 1000+country) - see
# https://dn42.eu/howto/BGP-communities#route-origin. Only applied to routes
# you originate (source = RTS_STATIC), never to transited routes. Leave
# either blank to skip that community.
region: 41      # 41 = Europe - see README for the full region table
country: 1276   # 1276 = Germany (ISO-3166-1 numeric + 1000)

peers:
  # Example 1: MP-BGP over IPv6 + extended next hop (recommended default).
  # A single BGP session over the tunnel's IPv6 link-local address carries
  # both IPv4 and IPv6 routes (RFC 8950) - no separate IPv4 session, and no
  # IPv4 tunnel address is strictly required.
  - name: examplepeer1
    description: "AS4242421111 - examplepeer1 - peered via dn42 registry"
    asn: 4242421111
    wg:
      listen_port: 21001                 # unique per peer
      endpoint: peer1.example.com:21000  # their endpoint (omit if they connect to you)
      pubkey: "PEER_WIREGUARD_PUBLIC_KEY="
      address: 172.22.1.1/32             # your side, /32 point-to-point
      peer_address: 172.22.1.2/32        # their side, for AllowedIPs
      link_local: fe80::1/64             # optional: pin an explicit link-local
                                          # instead of the kernel's auto EUI-64
                                          # address, so the bird neighbor below
                                          # is predictable across re-key/reboot
    bgp:
      mode: enh                          # "enh" (default) or "dual", see README
      neighbor: fe80::1%wg-examplepeer1  # their link-local, %interface required
      multihop: false
      bfd: false                         # set true only if both sides support/enable BFD
      extended_messages: true            # allow larger BGP UPDATE messages
    # Link-characteristic BGP communities, see:
    # https://dn42.eu/howto/BGP-communities#peering-link-characteristics
    # Use the bgp-community.rb / dn42-comgen tools linked there to measure
    # these automatically instead of guessing.
    community:
      latency: 3        # (64511,3)  7.3-20ms
      bandwidth: 24      # (64511,24) >=100mbit
      crypto: 35         # (64511,35) WireGuard w/ PSK - PFS + PQ resistant
      topology: 83       # (64511,83) tunnel (WireGuard/fastd/GRE)
      packetloss: 91     # (64511,91) ~0% packet loss

  # Example 2: "dual" mode - two independent sessions (one IPv4, one IPv6),
  # for peers that don't support/want extended next hop. Requires both
  # bgp.neighbor (their IPv4 tunnel address) and bgp.neighbor_v6.
  - name: examplepeer2
    description: "AS4242422222 - examplepeer2"
    asn: 4242422222
    wg:
      listen_port: 21002
      endpoint: ""                       # blank = they dial us, no persistent endpoint
      pubkey: "OTHER_PEER_PUBLIC_KEY="
      address: 172.22.1.1/32
      peer_address: 172.22.1.3/32
      link_local: ""                     # blank = use kernel auto EUI-64
    bgp:
      mode: dual
      neighbor: 172.22.1.3               # their IPv4 tunnel address (ipv4 session)
      neighbor_v6: fe80::1%wg-examplepeer2  # their link-local (ipv6 session)
      multihop: false
      bfd: false
      extended_messages: true
    community:
      latency: 4
      bandwidth: 23
      crypto: 34
      topology: 83
      packetloss: 91
